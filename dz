# run_lesson5.py

import argparse
import csv
import random
from pathlib import Path

import torch
from torch import nn
from torch.utils.data import DataLoader, Subset
from torchvision import datasets, models, transforms


# БЛОК 1. Воспроизводимость

def set_seed(seed=42):
    """
    Фиксируем генераторы случайных чисел.

    Это помогает повторять разбиение данных и эксперименты.
    Полное совпадение результатов на разном оборудовании
    при этом не гарантируется.
    """
    random.seed(seed)
    torch.manual_seed(seed)

    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


# БЛОК 2. Собственная аугментация — гауссовский шум

class GaussianNoise:
    """
    Добавляет небольшой случайный шум к изображению.

    На входе ожидается тензор с пикселями от 0 до 1.
    """

    def __init__(self, std=0.02):
        self.std = std

    def __call__(self, image):
        noise = torch.randn_like(image) * self.std

        # После добавления шума сохраняем значения
        # пикселей в диапазоне от 0 до 1.
        return (image + noise).clamp(0.0, 1.0)


# БЛОК 3. Преобразования изображений

def make_transforms(use_augmentations=True):
    """
    Возвращает преобразования для:
    1. Обучения.
    2. Валидации и тестирования.
    """

    # Нормализация, соответствующая предобученной ResNet-18.
    mean = (0.485, 0.456, 0.406)
    std = (0.229, 0.224, 0.225)

    eval_transform = transforms.Compose([
        transforms.Resize(256),
        transforms.CenterCrop(224),
        transforms.ToTensor(),
        transforms.Normalize(mean, std),
    ])

    if not use_augmentations:
        return eval_transform, eval_transform

    train_transform = transforms.Compose([
        # Случайно вырезаем часть изображения
        # и приводим её к размеру 224 x 224.
        transforms.RandomResizedCrop(
            size=224,
            scale=(0.7, 1.0),
        ),

        # С вероятностью 50% отражаем изображение.
        transforms.RandomHorizontalFlip(p=0.5),

        # Немного меняем цветовые характеристики.
        transforms.ColorJitter(
            brightness=0.2,
            contrast=0.2,
            saturation=0.2,
        ),

        # Превращаем PIL-изображение в тензор.
        transforms.ToTensor(),

        # С вероятностью 20% добавляем шум.
        transforms.RandomApply(
            [GaussianNoise(std=0.02)],
            p=0.2,
        ),

        # Нормализуем после аугментаций.
        transforms.Normalize(mean, std),
    ])

    return train_transform, eval_transform


# БЛОК 4. Загрузка датасетов

def make_datasets(args, train_transform, eval_transform):
    """
    Если указан --data, используем собственные изображения.

    Иначе скачиваем CIFAR-10 и выделяем из его обучающей
    части отдельную валидационную выборку.
    """

    if args.data is not None:
        root = Path(args.data)

        for split in ("train", "val"):
            if not (root / split).is_dir():
                raise FileNotFoundError(
                    f"Не найдена папка: {root / split}"
                )

        train_dataset = datasets.ImageFolder(
            root=root / "train",
            transform=train_transform,
        )

        val_dataset = datasets.ImageFolder(
            root=root / "val",
            transform=eval_transform,
        )

        if (
            train_dataset.class_to_idx
            != val_dataset.class_to_idx
        ):
            raise ValueError(
                "Папки train и val должны содержать "
                "одинаковые классы."
            )

        classes = list(train_dataset.classes)
        test_dataset = None

        # Для своего датасета папка test необязательна.
        if (root / "test").is_dir():
            test_dataset = datasets.ImageFolder(
                root=root / "test",
                transform=eval_transform,
            )

            if (
                train_dataset.class_to_idx
                != test_dataset.class_to_idx
            ):
                raise ValueError(
                    "Папки train и test должны содержать "
                    "одинаковые классы."
                )

        dataset_name = "imagefolder"

    else:
        # Два представления одних и тех же исходных данных.
        #
        # В первом включены обучающие аугментации.
        # Во втором преобразования детерминированные.
        train_source = datasets.CIFAR10(
            root=args.data_root,
            train=True,
            download=True,
            transform=train_transform,
        )

        val_source = datasets.CIFAR10(
            root=args.data_root,
            train=True,
            download=True,
            transform=eval_transform,
        )

        test_dataset = datasets.CIFAR10(
            root=args.data_root,
            train=False,
            download=True,
            transform=eval_transform,
        )

        generator = torch.Generator().manual_seed(42)

        indices = torch.randperm(
            len(train_source),
            generator=generator,
        ).tolist()

        # 10% исходной обучающей выборки — валидация.
        val_size = len(indices) // 10

        val_indices = indices[:val_size]
        train_indices = indices[val_size:]

        # Индексы не пересекаются:
        # валидационные изображения не участвуют в обучении.
        train_dataset = Subset(
            train_source,
            train_indices,
        )

        val_dataset = Subset(
            val_source,
            val_indices,
        )

        classes = list(test_dataset.classes)
        dataset_name = "cifar10"

    # Для быстрой проверки можно уменьшить только train.
    if args.limit > 0:
        generator = torch.Generator().manual_seed(42)

        indices = torch.randperm(
            len(train_dataset),
            generator=generator,
        ).tolist()

        train_dataset = Subset(
            train_dataset,
            indices[:args.limit],
        )

    return (
        train_dataset,
        val_dataset,
        test_dataset,
        classes,
        dataset_name,
    )


def make_loader(dataset, batch_size, shuffle):
    """
    DataLoader выдаёт изображения небольшими группами — батчами.
    """
    return DataLoader(
        dataset,
        batch_size=batch_size,
        shuffle=shuffle,
        num_workers=0,
        pin_memory=torch.cuda.is_available(),
    )


# БЛОК 5. Создание модели

def make_model(num_classes, mode):
    """
    Режимы:
    head     — обучаем только новый классификатор;
    finetune — дообучаем всю предобученную сеть;
    scratch  — обучаем всю сеть с нуля.
    """

    if mode == "scratch":
        weights = None
    else:
        weights = models.ResNet18_Weights.DEFAULT

    model = models.resnet18(weights=weights)

    if mode == "head":
        # Замораживаем уже обученные параметры.
        for parameter in model.parameters():
            parameter.requires_grad = False

    # Исходная ResNet-18 предсказывает 1000 классов.
    # Заменяем последний слой под наш датасет.
    #
    # Новый слой по умолчанию обучаемый.
    input_features = model.fc.in_features

    model.fc = nn.Linear(
        input_features,
        num_classes,
    )

    return model


# БЛОК 6. Одна эпоха обучения или проверки

def run_epoch(
    model,
    loader,
    criterion,
    device,
    optimizer=None,
    freeze_batchnorm=False,
):
    """
    Если optimizer передан — обучаем модель.
    Если optimizer=None — только оцениваем.
    """

    training = optimizer is not None
    model.train(training)

    if training and freeze_batchnorm:
        # requires_grad=False замораживает параметры,
        # но не останавливает обновление статистик BatchNorm.
        #
        # Поэтому при обучении только головы отдельно
        # переводим BatchNorm в режим оценки.
        for module in model.modules():
            if isinstance(module, nn.BatchNorm2d):
                module.eval()

    total_loss = 0.0
    total_correct = 0
    total_examples = 0

    for images, labels in loader:
        images = images.to(
            device,
            non_blocking=True,
        )

        labels = labels.to(
            device,
            non_blocking=True,
        )

        if training:
            optimizer.zero_grad(set_to_none=True)

        # Во время проверки градиенты не вычисляем.
        with torch.set_grad_enabled(training):
            logits = model(images)

            loss = criterion(logits, labels)

            if training:
                loss.backward()
                optimizer.step()

        predictions = logits.argmax(dim=1)
        batch_size = labels.size(0)

        total_loss += loss.item() * batch_size

        total_correct += (
            predictions == labels
        ).sum().item()

        total_examples += batch_size

    if total_examples == 0:
        raise ValueError("Выборка не содержит изображений.")

    average_loss = total_loss / total_examples
    accuracy = total_correct / total_examples

    return average_loss, accuracy


# БЛОК 7. Настройки запуска

def parse_args():
    parser = argparse.ArgumentParser(
        description=(
            "Урок 5: аугментации и transfer learning "
            "с использованием ResNet-18."
        )
    )

    parser.add_argument(
        "--data",
        default=None,
        help="Путь к своему датасету с папками train и val.",
    )

    parser.add_argument(
        "--data-root",
        default="./data",
        help="Куда скачивать CIFAR-10.",
    )

    parser.add_argument(
        "--mode",
        choices=["head", "finetune", "scratch"],
        default="head",
    )

    parser.add_argument(
        "--epochs",
        type=int,
        default=5,
    )

    parser.add_argument(
        "--batch-size",
        type=int,
        default=32,
    )

    parser.add_argument(
        "--lr",
        type=float,
        default=None,
    )

    parser.add_argument(
        "--limit",
        type=int,
        default=0,
        help="Максимум обучающих изображений; 0 — все.",
    )

    parser.add_argument(
        "--no-augment",
        action="store_true",
        help="Отключить случайные аугментации.",
    )

    parser.add_argument(
        "--output",
        default="outputs/lesson5",
    )

    args = parser.parse_args()

    if args.epochs < 1:
        parser.error("--epochs должен быть не меньше 1.")

    if args.batch_size < 1:
        parser.error("--batch-size должен быть не меньше 1.")

    if args.limit < 0:
        parser.error("--limit не может быть отрицательным.")

    if args.lr is not None and args.lr <= 0:
        parser.error("--lr должен быть положительным.")

    return args


# БЛОК 8. Полный запуск эксперимента

def main():
    args = parse_args()
    set_seed(42)

    device = torch.device(
        "cuda" if torch.cuda.is_available() else "cpu"
    )

    output_dir = Path(args.output)
    output_dir.mkdir(parents=True, exist_ok=True)

    checkpoint_path = output_dir / "best.pt"
    metrics_path = output_dir / "metrics.csv"

    train_transform, eval_transform = make_transforms(
        use_augmentations=not args.no_augment
    )

    (
        train_dataset,
        val_dataset,
        test_dataset,
        classes,
        dataset_name,
    ) = make_datasets(
        args,
        train_transform,
        eval_transform,
    )

    train_loader = make_loader(
        train_dataset,
        args.batch_size,
        shuffle=True,
    )

    val_loader = make_loader(
        val_dataset,
        args.batch_size,
        shuffle=False,
    )

    test_loader = None

    if test_dataset is not None:
        test_loader = make_loader(
            test_dataset,
            args.batch_size,
            shuffle=False,
        )

    model = make_model(
        num_classes=len(classes),
        mode=args.mode,
    ).to(device)

    # При полном дообучении используем меньший шаг,
    # чтобы осторожнее менять предобученные веса.
    if args.lr is not None:
        learning_rate = args.lr
    elif args.mode == "finetune":
        learning_rate = 1e-4
    else:
        learning_rate = 1e-3

    criterion = nn.CrossEntropyLoss()

    optimizer = torch.optim.AdamW(
        [
            parameter
            for parameter in model.parameters()
            if parameter.requires_grad
        ],
        lr=learning_rate,
        weight_decay=1e-4,
    )

    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(
        optimizer,
        T_max=args.epochs,
    )

    metadata = {
        "architecture": "resnet18",
        "dataset": dataset_name,
        "input_shape": [3, 224, 224],
        "num_classes": len(classes),
        "classes": classes,
        "mean": [0.485, 0.456, 0.406],
        "std": [0.229, 0.224, 0.225],
        "mode": args.mode,
        "augmentations": not args.no_augment,
    }

    trainable_parameters = sum(
        parameter.numel()
        for parameter in model.parameters()
        if parameter.requires_grad
    )

    print(f"Устройство: {device}")
    print(f"Датасет: {dataset_name}")
    print(f"Классы: {classes}")
    print(f"Режим: {args.mode}")
    print(f"Аугментации: {not args.no_augment}")
    print(f"Обучающих изображений: {len(train_dataset)}")
    print(f"Валидационных изображений: {len(val_dataset)}")
    print(f"Обучаемых параметров: {trainable_parameters:,}")
    print(f"Learning rate: {learning_rate}")
    print()

    best_accuracy = -1.0

    with metrics_path.open(
        "w",
        newline="",
        encoding="utf-8",
    ) as file:
        writer = csv.writer(file)

        writer.writerow([
            "epoch",
            "train_loss",
            "train_accuracy",
            "val_loss",
            "val_accuracy",
        ])

        for epoch in range(1, args.epochs + 1):
            train_loss, train_accuracy = run_epoch(
                model=model,
                loader=train_loader,
                criterion=criterion,
                device=device,
                optimizer=optimizer,
                freeze_batchnorm=args.mode == "head",
            )

            val_loss, val_accuracy = run_epoch(
                model=model,
                loader=val_loader,
                criterion=criterion,
                device=device,
            )

            scheduler.step()

            writer.writerow([
                epoch,
                train_loss,
                train_accuracy,
                val_loss,
                val_accuracy,
            ])

            file.flush()

            print(
                f"Эпоха {epoch:02d}/{args.epochs} | "
                f"train loss: {train_loss:.4f} | "
                f"train acc: {train_accuracy:.2%} | "
                f"val loss: {val_loss:.4f} | "
                f"val acc: {val_accuracy:.2%}"
            )

            # Выбираем модель по валидации, а не по тесту.
            if val_accuracy > best_accuracy:
                best_accuracy = val_accuracy

                state_dict = {
                    name: tensor.detach().cpu().clone()
                    for name, tensor
                    in model.state_dict().items()
                }

                torch.save(
                    {
                        "state_dict": state_dict,
                        "meta": metadata,
                        "epoch": epoch,
                        "val_accuracy": val_accuracy,
                    },
                    checkpoint_path,
                )

                print("  Сохранена новая лучшая модель.")

    # Загружаем лучшую модель, а не просто последнюю.
    checkpoint = torch.load(
        checkpoint_path,
        map_location="cpu",
        weights_only=True,
    )

    model.load_state_dict(checkpoint["state_dict"])

    print(
        f"\nЛучшая accuracy на валидации: "
        f"{best_accuracy:.2%}"
    )

    # Тест используем после завершения обучения
    # и выбора лучшего checkpoint.
    if test_loader is not None:
        test_loss, test_accuracy = run_epoch(
            model=model,
            loader=test_loader,
            criterion=criterion,
            device=device,
        )

        print(f"Test loss: {test_loss:.4f}")
        print(f"Test accuracy: {test_accuracy:.2%}")
    else:
        print(
            "Тестовая выборка не задана: "
            "итоговое тестирование пропущено."
        )

    print(f"Веса: {checkpoint_path}")
    print(f"История обучения: {metrics_path}")


if __name__ == "__main__":
    main()
